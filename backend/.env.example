# ---- App ----
APP_ENV=development
SECRET_KEY=change-this-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=sqlite:///./clinic.db

# ---- LLM (Anthropic) ----
# If USE_MOCK_LLM=true, no key needed and canned structured responses are used.
USE_MOCK_LLM=true
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- Email ----
# If USE_MOCK_EMAIL=true, emails are written to backend/sent_emails/ instead of sent.
USE_MOCK_EMAIL=true
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=
EMAIL_FROM=clinic@example.com

# ---- Google Calendar ----
# If USE_MOCK_CALENDAR=true, calendar events are simulated and logged, no OAuth needed.
USE_MOCK_CALENDAR=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/calendar/oauth2callback

# ---- Background jobs ----
REMINDER_POLL_SECONDS=60
